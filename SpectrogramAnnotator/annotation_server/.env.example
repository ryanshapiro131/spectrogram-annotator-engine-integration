# Copy to annotation_server/.env and fill in (.env itself is git-ignored).

# Full path to the compiled spectrogram-engine binary (no quotes needed,
# spaces are fine), e.g.
#   Linux:   /home/you/SpectrogramEngine-main/build/spectrogram-engine
#   Windows: C:\path\to\SpectrogramEngine-main\build\Release\spectrogram-engine.exe
SPECTROGRAM_ENGINE_BIN=

# Where decoded audio + tile images are stored (~2.6 GB per hour of audio).
# Every tile request reads from here, so use fast LOCAL disk, not network
# storage. Defaults to the system temp dir (/tmp/spectrogram_cache on Linux).
SPECTROGRAM_CACHE_DIR=

# PostgreSQL connection (see DATABASE.md for creating the database + user).
# Leave empty to run without accounts/projects (standalone /audio only).
DATABASE_URL=postgresql://annotator:change-me@localhost:5432/annotator

# Signs session tokens. Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Session lifetime in days.
SESSION_DAYS=7

# Google sign-in: OAuth client id from Google Cloud Console ->
# APIs & Services -> Credentials (type "Web application"). See DATABASE.md.
GOOGLE_CLIENT_ID=

# Developer login: sign in by typing any email, NO password. For testing on
# your own machine only. NEVER enable on the shared server: anyone who can
# reach it could sign in as anyone. The server prints a warning when it's on.
DEV_LOGIN=false

# Sign-in is on when DATABASE_URL + SESSION_SECRET are set and at least one of
# GOOGLE_CLIENT_ID / DEV_LOGIN is. With REQUIRE_AUTH=true every API call
# (uploads, audio, overview) needs a signed-in user; the frontend then sends
# everyone to the login page first. Keep it false only if sign-in is off.
REQUIRE_AUTH=true
